# Copy to .env and adjust. Defaults assume Ollama on the same machine.

# Paths
DATA_DIR=~/brain
CHUNKS_PATH=~/brain/second-brain-rag/chunks.jsonl
CHROMA_DIR=~/brain/chroma
COLLECTION=second_brain

# Embeddings: always local Ollama (free, private)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=mxbai-embed-large

# Generation: ollama (local, default) | gemini (opt-in, per query in the UI)
GEN_PROVIDER=ollama
GEN_MODEL=qwen3:8b
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Retrieval
TOP_K=6
MIN_SIMILARITY=0.35          # refusal gate (semantic)
GRAPH_HOP=true
HYBRID_ENABLED=true          # BM25 + semantic via Reciprocal Rank Fusion
RRF_K=60
HYBRID_CANDIDATES=20
HOW_BOOST=0.08               # know-vs-do routing nudge
RERANK_ENABLED=false         # cross-encoder rerank; measured worse than RRF here

# Drill (quiz/quiz_app.py) - optional overrides
# QUIZ_PORT=8010
# QUIZ_MODEL=qwen3:8b
# QUIZ_PREFETCH=2
